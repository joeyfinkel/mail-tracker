{
  "name": "mail-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter mail-tracker-web dev",
    "preview": "pnpm --filter mail-tracker-web preview",
    "build": "vp run -r build",
    "typecheck": "vp run -r typecheck",
    "test": "vp run -r test",
    "format": "biome format --write . && eslint --fix .",
    "format:check": "biome format . && eslint .",
    "intent:list": "intent list",
    "intent:stale": "intent stale"
  },
  "intent": {
    "skills": [
      "@jfdevelops/*",
      "@tanstack/*",
      "@ui-sdk/core"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@jfdevelops/cli": "0.8.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/intent": "^0.5.6",
    "eslint": "^10.14.0",
    "portless": "^0.18.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite-plus": "^1.5.0"
  },
  "pnpm": {
    "overrides": {
      "@vitest/browser-preview": "5.1.1",
      "@vitest/ui": "5.1.1",
      "vitest": "5.1.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
