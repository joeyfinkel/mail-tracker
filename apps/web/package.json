{
  "name": "mail-tracker-web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "portless mail-tracker vite dev",
    "generate-routes": "vite build",
    "build": "vite build",
    "test": "vitest run",
    "preview": "portless mail-tracker-preview vite preview",
    "typecheck": "tsc --noEmit",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check src vite.config.ts tsr.config.json wrangler.jsonc",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@jfdevelops/react-layout": "^4.1.0",
    "@jfdevelops/react-layout-adapter-zod": "^1.0.0",
    "@mail-tracker/ui": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/query-db-collection": "^1.5.2",
    "@tanstack/react-db": "1.0.0-rc.1.5",
    "@tanstack/react-query": "^5.108.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "1.169.7",
    "@ui-sdk/core": "0.1.0-beta.12",
    "@ui-sdk/react": "0.1.0-beta.12",
    "lucide-react": "^0.577.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.8.7",
    "@tanstack/react-devtools": "^0.10.15",
    "@tanstack/react-query-devtools": "^5.108.1",
    "@tanstack/react-router-devtools": "^1.167.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.70.0"
  }
}
